typeset -g PIBOX_PROFILE="${${(%):-%x}:A:h}/infra.json"

pibox() {
    local root repo git_dir dir arg
    local -a grants=() pi_args=()

    while (( $# )); do
        arg="$1"
        shift
        if [[ "$arg" == -- ]]; then
            pi_args+=("$@")
            break
        elif [[ -e "$arg" ]]; then
            grants+=(--allow "${arg:A}")
        else
            pi_args+=("$arg")
        fi
    done

    # Prefer the jj workspace root, then the Git repository root.
    if command -v jj >/dev/null 2>&1 &&
       root=$(command jj root --ignore-working-copy 2>/dev/null); then
        # Linked workspaces store a path relative to .jj in this file.
        if [[ -f "$root/.jj/repo" ]]; then
            repo=$(<"$root/.jj/repo")
            [[ "$repo" == /* ]] || repo="$root/.jj/$repo"
            grants+=(--allow "${repo:A}")
        fi
        if git_dir=$(command jj git root --ignore-working-copy 2>/dev/null); then
            git_dir="${git_dir:A}"
            [[ "$git_dir" == "${root:A}"/* ]] || grants+=(--allow "$git_dir")
        fi
    elif root=$(command git rev-parse --show-toplevel 2>/dev/null); then
        :
    else
        root="$PWD"
    fi

    printf 'Pi working directory: %s\nSandbox grant:       %s\n' \
        "$PWD" "$root" >&2
    for dir in "${grants[@]}"; do
        [[ "$dir" == --allow ]] || printf 'Extra sandbox grant: %s\n' "$dir" >&2
    done

    command nono run \
        --profile "$PIBOX_PROFILE" \
        --allow "$root" \
        "${grants[@]}" \
        -- pi "${pi_args[@]}"
}
